# =============================================================================
# SAFE AI Hacker — environment configuration (copy to `.env` and fill in)
# Everything tunable lives here. `.env` is gitignored — never commit secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Engagement scope (REQUIRED)
# ---------------------------------------------------------------------------
# Comma-separated list of authorized in-scope URLs (frontend, API, backend roots)
SAHW_SCOPE=http://TARGET:3000,http://TARGET
# Optional: explicit out-of-scope URL path prefixes (denied even if host matches)
SAHW_OUT_OF_SCOPE=
# Optional: additional in-scope CIDR ranges (e.g. internal network for SSRF validation)
SAHW_IN_SCOPE_CIDRS=

# Authorization is a MANDATORY precondition (ref + test window)
SAHW_AUTH_REF=
SAHW_AUTH_START=
SAHW_AUTH_END=

# ---------------------------------------------------------------------------
# Model / LLM
# ---------------------------------------------------------------------------
# OpenRouter API key (secret)
SAHW_OPENROUTER_KEY=
# Model to use for the agents and the judge
SAHW_MODEL=z-ai/glm-5.3-flashx
# Optional: a stronger model just for the Axiom judge (defaults to SAHW_MODEL)
SAHW_JUDGE_MODEL=
# Sampling temperature (0 = deterministic-ish)
SAHW_TEMPERATURE=0.3
# Max tool-calling turns per agent run
SAHW_MAX_TURNS=12
# Override the OpenRouter base URL (default https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Budget (the Limit stop)
# ---------------------------------------------------------------------------
SAHW_BUDGET_USD=1
SAHW_BUDGET_TURNS=100
SAHW_BUDGET_TOKENS=1000000

# ---------------------------------------------------------------------------
# Safety gate (AI Hacker Tether)
# ---------------------------------------------------------------------------
# Sandbox root — filesystem writes are confined here
SAHW_WORKSPACE=/tmp/sahw-sandbox
# Authorized impact tiers (read,probe,state_change,shell). DoS/destructive always denied.
SAHW_AUTHORIZED_TIERS=read,probe,state_change,shell

# ---------------------------------------------------------------------------
# Axiom (validation core)
# ---------------------------------------------------------------------------
# Deterministic confirmation bar (0..1)
SAHW_AXIOM_CONFIDENCE=0.75
# Judge confirmation bar (0..1) — higher = stricter false-positive elimination
SAHW_AXIOM_JUDGE_THRESHOLD=0.8

# ---------------------------------------------------------------------------
# Observability (Langfuse + ledger)
# ---------------------------------------------------------------------------
SAHW_LANGFUSE_HOST=
SAHW_LANGFUSE_PUBLIC_KEY=
SAHW_LANGFUSE_SECRET_KEY=
# Local NDJSON event ledger (The Ledger plugin also writes here)
SAHW_LEDGER_FILE=/tmp/sahw-ledger/events.ndjson

# ---------------------------------------------------------------------------
# Neo4j (graph state — findings / endpoints / chains)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# OOB / OAST listener (reverse-shell + out-of-band callback catcher)
# ---------------------------------------------------------------------------
OOB_ANSWER_IP=0.0.0.0
OOB_DNS_PORT=53
OOB_HTTP_PORT=80
OOB_SHELL_PORT=4444

# ---------------------------------------------------------------------------
# OpenCode engine (optional — direct-LLM mode needs none of these)
# ---------------------------------------------------------------------------
# OPENCODE_URL=http://engine:4096
# OPENCODE_PASSWORD=

# ---------------------------------------------------------------------------
# Docker compose (deployment host port mappings)
# ---------------------------------------------------------------------------
# OOB_DNS_HOST_PORT=53
# OOB_HTTP_HOST_PORT=8080
# OOB_SHELL_HOST_PORT=4444
