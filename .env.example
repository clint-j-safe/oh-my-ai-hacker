# SAFE AI Hacker — runtime configuration contract
#
# Copy to .env and fill in. .env is gitignored; this file is the committed
# reference and must never contain a real secret or a real target.
#
# Every knob the orchestrator reads is here. Nothing in docs/agents/*.md,
# docs/PROMPTS.md or skills/ is environment-specific — behaviour is tuned
# here, not by editing prompts.

# ─────────────────────────────────────────────────────────────────────────────
# ENGAGEMENT SCOPE  — the Tether's allowlist. Nothing outside this is reachable.
# ─────────────────────────────────────────────────────────────────────────────
SAHW_SCOPE=                      # comma-separated in-scope URLs (host+port). THE definition of scope.
SAHW_OUT_OF_SCOPE=               # explicit denies, applied after SAHW_SCOPE
SAHW_IN_SCOPE_CIDRS=             # optional CIDRs, only if the RoE grants them
SAHW_AUTH_REF=                   # authorization document reference
SAHW_AUTH_START=                 # testing window open  (ISO-8601 UTC)
SAHW_AUTH_END=                   # testing window close (ISO-8601 UTC)
SAHW_AUTHORIZED_TIERS=L2         # max safety tier. L2 = read-only / reversible.

# ─────────────────────────────────────────────────────────────────────────────
# PROVIDER PROFILE  — see §4.1. Swapping this changes no agent, prompt or skill.
# ─────────────────────────────────────────────────────────────────────────────
SAHW_PROFILE=test                # test = OpenRouter | prod = SageMaker GLM 5.3

# -- test profile (building and testing) --
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SAHW_OPENROUTER_KEY=
SAHW_MODEL=                      # resolves {{REASONING_MODEL}}
SAHW_FAST_MODEL=                 # resolves {{FAST_MODEL}}; falls back to SAHW_MODEL
SAHW_JUDGE_MODEL=                # fuzzy calls only; never the hard gate

# -- prod profile (self-hosted, later) --
SAGEMAKER_BASE_URL=              # https://<endpoint>/openai/v1
SAGEMAKER_MODEL=glm-5.3          # resolves both logical names
SAHW_GATEWAY_URL=                # issues the short-lived per-engagement credential
# No static SageMaker key: the credential is fetched per engagement from the AI Gateway.

SAHW_TEMPERATURE=                # global default; per-agent frontmatter overrides it

# ─────────────────────────────────────────────────────────────────────────────
# BUDGET CEILINGS  — tokens and turns are authoritative; USD only where priced.
# A self-hosted endpoint bills for uptime and reports cost 0, so a USD-only
# ceiling silently never fires. See §12.
# ─────────────────────────────────────────────────────────────────────────────
SAHW_MAX_TURNS=40                # assistant turns per agent conversation
SAHW_BUDGET_TURNS=200            # assistant turns per beat, all agents
SAHW_BUDGET_TOKENS=2000000       # total tokens per beat
SAHW_BUDGET_USD=25               # enforced only when the profile is priced per token
SAHW_REQUEST_TIMEOUT_MS=3600000  # per API request (SDK default 600000 is too short)
SAHW_PHASE_TIMEOUT_MS=5400000    # per phase; the orchestrator AbortSignal must trip FIRST
SAHW_MAX_RETRIES=0               # orchestrator owns retry policy, not the SDK

# ─────────────────────────────────────────────────────────────────────────────
# STALL DETECTION  — a beat that produces no executed work is a stall, however
# much the model talked. All four are evaluated per beat. See §5.4.
# ─────────────────────────────────────────────────────────────────────────────
SAHW_STALL_MIN_TOOL_CALLS=1      # < this many SUCCEEDED tool executions in a beat = stall
SAHW_STALL_MIN_ARTIFACTS=1       # < this many new hashed artifacts in a beat = stall
SAHW_STALL_MAX_REPEAT_CALLS=3    # identical (tool, args) repeated this often = stall
SAHW_STALL_MAX_BARREN_BEATS=2    # consecutive stalled beats before the run aborts
SAHW_STALL_EXIT_CODE=3           # non-zero. A stalled run MUST NOT exit 0.

# ─────────────────────────────────────────────────────────────────────────────
# VERDICTS  — the Axiom. Deterministic replay decides; the judge is advisory.
# ─────────────────────────────────────────────────────────────────────────────
SAHW_AXIOM_CONFIDENCE=0.8        # below this, escalate to the adjudicator
SAHW_AXIOM_JUDGE_THRESHOLD=0.7   # judge-model threshold for fuzzy calls
SAHW_ADJUDICATOR_COUNT=3         # independent adjudicators (odd number; 3-5)
SAHW_ADJUDICATOR_QUORUM=2        # agreeing verdicts required to CONFIRM

# ─────────────────────────────────────────────────────────────────────────────
# STATE
# ─────────────────────────────────────────────────────────────────────────────
SAHW_WORKSPACE=                  # sandbox + artifact store root
SAHW_LEDGER_FILE=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=engagement        # the graph agents read through graph_query

# Benchmark coverage — a SEPARATE database. The execution plane holds no
# credential for it, so the answer key cannot reach an agent. See §8.
NEO4J_COVERAGE_DATABASE=coverage
NEO4J_COVERAGE_USER=             # harness only — never exported into a sandbox
NEO4J_COVERAGE_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY  — Langfuse. trace id feeds the Provenance Gate (§10).
# ─────────────────────────────────────────────────────────────────────────────
SAHW_LANGFUSE_HOST=
SAHW_LANGFUSE_PUBLIC_KEY=
SAHW_LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=               # mirrors of the above, read by @langfuse/otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_USER_ID=

# ─────────────────────────────────────────────────────────────────────────────
# OUT-OF-BAND (OAST)  — blind-vulnerability correlation. exploit-constructor only.
# ─────────────────────────────────────────────────────────────────────────────
OOB_ANSWER_IP=
OOB_DNS_PORT=53
OOB_HTTP_PORT=80
OOB_SHELL_PORT=4444

# ─────────────────────────────────────────────────────────────────────────────
# PAYLOAD LIBRARY  — read-only mount; payloads NEVER enter prompt context (§9)
# ─────────────────────────────────────────────────────────────────────────────
SAHW_PAYLOAD_LIBRARY=/opt/payload-library   # mount point, read-only in every sandbox
SAHW_PAYLOAD_DB=/opt/payload-library/db/payload-library.sqlite3
SAHW_PAYLOAD_SETS=/opt/payload-library/sets/generated
SAHW_PAYLOAD_PAT_SHA=                       # PayloadsAllTheThings pinned commit SHA
SAHW_PAYLOAD_SECLISTS_SHA=                  # SecLists pinned commit SHA
SAHW_PAYLOAD_MAX_SET=500                    # max payloads materialised per set
SAHW_PAYLOAD_SET_TTL_H=24                   # generated sets discarded after N hours
SAHW_WORDLIST_TIER=standard                 # small | standard | large
SAHW_WORDLIST_MAX_LINES=5000                # hard cap for the standard tier
SAHW_PAYLOAD_PREVIEW_LINES=10               # wordlist_preview ceiling

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS  — ClickHouse: payload_usage_events + findings telemetry (§9.6)
# ─────────────────────────────────────────────────────────────────────────────
CLICKHOUSE_DSN=
CLICKHOUSE_DATABASE=sahw
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
