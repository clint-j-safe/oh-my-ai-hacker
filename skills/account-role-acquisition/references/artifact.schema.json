{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "account-role-acquisition artifact",
  "type": "object",
  "required": ["session_pool", "registration_status"],
  "additionalProperties": true,
  "properties": {
    "session_pool": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "cookies", "auth_headers", "state_spill_id"],
        "additionalProperties": true,
        "properties": {
          "role": { "type": "string" },
          "username": { "type": "string" },
          "cookies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" },
                "domain": { "type": "string" },
                "httpOnly": { "type": "boolean" },
                "secure": { "type": "boolean" },
                "sameSite": { "type": "string" }
              }
            }
          },
          "auth_headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "state_spill_id": { "type": "string", "description": "Spill ID of the full browser state (storage_state, localStorage, sessionStorage)" },
          "mfa_enrolled": { "type": "boolean" }
        }
      }
    },
    "registration_status": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "failed_roles": { "type": "array", "items": { "type": "string" } },
        "captcha_bypass_used": { "type": "boolean" }
      }
    },
    "meta": { "type": "object" },
    "scope_summary": { "type": "object" },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "error"],
        "properties": { "stage": { "type": "string" }, "error": { "type": "string" } }
      }
    }
  }
}
