        "via": "(?i)vegur"
      }
    },
    {
      "product": "DigitalOcean App Platform",
      "kind": "cloud",
      "headers": {
        "x-do-app-origin": ".+",
        "x-do-orig-status": ".+"
      }
    },
    {
      "product": "GitHub Pages",
      "kind": "cloud",
