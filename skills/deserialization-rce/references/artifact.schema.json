{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deserialization-rce artifact",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": true,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "gadget_chain", "parameter"],
        "additionalProperties": true,
        "properties": {
          "language": { "enum": ["java", "php", "python", "node", "ruby"] },
          "gadget_chain": { "type": "string" },
          "parameter": { "type": "string" },
          "payload_spill_id": { "type": "string" },
          "oob_confirmed": { "type": "boolean" }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "safety": {
          "type": "object",
          "properties": {
            "oob_only": { "type": "boolean" },
            "command_execution_weaponized": { "type": "boolean" },
            "destructive_blocklist": { "type": "boolean" }
          }
        }
      }
    },
    "scope_summary": { "type": "object" },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "error"],
        "properties": { "stage": { "type": "string" }, "error": { "type": "string" } }
      }
    }
  }
}
