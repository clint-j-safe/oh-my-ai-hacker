{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAFE AI Hacker finding artifact",
  "description": "Canonical finding record produced by the pipeline and finalized by AI Hacker Axiom. Consistent with docs/agents/core.md reporting_format and the skills/*/references/artifact.schema.json convention. No target specifics are baked in; all values are discovered at runtime.",
  "type": "object",
  "required": ["finding_id", "title", "vuln_class", "affected", "invariant", "verdict", "evidence", "provenance"],
  "additionalProperties": true,
  "properties": {
    "finding_id": { "type": "string", "description": "Engagement-local id, e.g. SAHW-0001" },
    "title": { "type": "string" },
    "vuln_class": {
      "type": "string",
      "description": "e.g. path_traversal, xxe, sqli, idor, deserialization_rce, business_logic, auth_bypass, crypto_disclosure, jwt_weak_key, rate_limit_absence, cors_misconfig, info_disclosure, ssrf"
    },
    "cwe": { "type": "array", "items": { "type": "string" }, "description": "e.g. [\"CWE-22\"]" },
    "owasp": { "type": "array", "items": { "type": "string" } },
    "affected": {
      "type": "object",
      "required": ["method", "url"],
      "properties": {
        "method": { "type": "string" },
        "url": { "type": "string", "description": "Absolute URL, discovered at runtime and within the provided in-scope URLs" },
        "parameter": { "type": "string" },
        "auth_required": { "type": "boolean" }
      }
    },
    "invariant": {
      "type": "object",
      "required": ["statement", "type"],
      "properties": {
        "statement": { "type": "string", "description": "The business/security rule that must hold" },
        "type": { "enum": ["body_contains", "status_in", "derived", "state_changed", "state_violated", "file_created_then_deleted"] },
        "expression": { "type": "string" }
      }
    },
    "poc": {
      "type": "object",
      "properties": {
        "poc_path": { "type": "string" },
        "commands": { "type": "array", "items": { "type": "string" } },
        "exploit_request": { "$ref": "#/$defs/httpRequest" },
        "control_request": { "$ref": "#/$defs/httpRequest" },
        "restoration": {
          "type": "object",
          "properties": {
            "needed": { "type": "boolean" },
            "performed": { "type": "boolean" },
            "verified": { "type": "string" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["exploit_response_excerpt"],
      "properties": {
        "exploit_response_excerpt": { "type": "string", "description": "VERBATIM excerpt proving the invariant violation" },
        "control_response_excerpt": { "type": "string" },
        "evidence_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "decided_by"],
      "properties": {
        "status": { "enum": ["CONFIRMED", "FALSE_POSITIVE", "NEEDS_REVIEW", "BLOCKED"] },
        "decided_by": { "enum": ["axiom_deterministic", "axiom_open_model", "adjudicator_escalation", "human"] },
        "judge": {
          "type": "object",
          "description": "Judge-model output (provider-routed) for fuzzy calls only (e.g. severity band); the invariant check itself is deterministic",
          "properties": {
            "invariant_violated": { "type": "number", "minimum": 0, "maximum": 1 },
            "verdict_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "severity_score": { "type": "number" },
            "escalated": { "type": "boolean" }
          }
        }
      }
    },
    "severity": {
      "type": "object",
      "properties": {
        "band": { "enum": ["critical", "high", "medium", "low", "info"] },
        "cvss_v3_1_vector": { "type": "string" },
        "cvss_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "context_note": { "type": "string" }
      }
    },
    "secret_refs": { "type": "array", "items": { "type": "string" }, "description": "{{secret:ref}} handles only — never plaintext" },
    "chain_refs": { "type": "array", "items": { "type": "string" }, "description": "chain_id(s) this finding participates in" },
    "remediation": {
      "type": "object",
      "properties": { "short_term": { "type": "string" }, "long_term": { "type": "string" } }
    },
    "provenance": {
      "type": "object",
      "required": ["utc", "stdout_sha256", "sandbox_id"],
      "description": "The Provenance Gate: no finding is CONFIRMED unless these link the trace, the exact command, the output hash, and the sandbox.",
      "properties": {
        "utc": { "type": "string" },
        "langfuse_trace_id": { "type": "string" },
        "exploit_request_hash": { "type": "string" },
        "stdout_sha256": { "type": "string" },
        "sandbox_id": { "type": "string" },
        "exit_code": { "type": "integer" }
      }
    }
  },
  "$defs": {
    "httpRequest": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "url": { "type": "string" },
        "headers": { "type": "object" },
        "body": { "type": ["string", "null"] }
      }
    }
  }
}
