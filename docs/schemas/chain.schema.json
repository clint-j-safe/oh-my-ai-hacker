{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAFE AI Hacker chain artifact",
  "description": "Exploitation chain proposed by the chain-reasoner and verified step-by-step by AI Hacker Axiom (deterministic replay). Matches CHAIN_REASONER_PROMPT output. No target specifics baked in.",
  "type": "object",
  "required": ["chain_id", "chain_name", "steps", "chained_severity", "verdict"],
  "additionalProperties": true,
  "properties": {
    "chain_id": { "type": "string", "description": "e.g. chain-01" },
    "chain_name": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_number", "produces"],
        "properties": {
          "step_number": { "type": "integer" },
          "finding_id": { "type": "string", "description": "The finding this step reuses, if any" },
          "action": { "type": "string" },
          "endpoint": { "type": "string" },
          "extract": {
            "type": "object",
            "properties": {
              "secret_type": { "type": "string" },
              "secret_ref": { "type": "string", "description": "{{secret:ref}} only" },
              "from_response": { "type": "string" }
            }
          },
          "inject": {
            "type": "object",
            "properties": { "parameter": { "type": "string" }, "value": { "type": "string" } }
          },
          "uses_secret": { "type": "string", "description": "{{secret:ref}} only" },
          "transformation": { "type": "string" },
          "produces": { "type": "string" },
          "step_verdict": {
            "type": "object",
            "description": "Per-step verdict — Axiom verifies each step by deterministic replay before the next",
            "properties": {
              "status": { "enum": ["PASSED", "FAILED", "ESCALATED"] },
              "judge_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "individual_severities": { "type": "array", "items": { "type": "string" } },
    "chained_impact": { "type": "string" },
    "chained_severity": { "enum": ["Critical", "High", "Medium", "Low"] },
    "impact_escalation": { "type": "string" },
    "missing_links": { "type": "array", "items": { "type": "string" }, "description": "Untested endpoints the chain needs; fed to the Threat Model hypothesis queue" },
    "restoration": {
      "type": "object",
      "properties": { "needed": { "type": "boolean" }, "steps": { "type": "array", "items": { "type": "object" } } }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "decided_by"],
      "properties": {
        "status": { "enum": ["CONFIRMED", "BROKEN", "NEEDS_REVIEW"] },
        "decided_by": { "enum": ["axiom_deterministic", "axiom_open_model", "adjudicator_escalation", "human"] },
        "failed_step": { "type": ["integer", "null"] },
        "judge": {
          "type": "object",
          "properties": {
            "chain_viable": { "type": "number", "minimum": 0, "maximum": 1 },
            "escalated": { "type": "boolean" }
          }
        }
      }
    },
    "rationale": { "type": "string" },
    "provenance": {
      "type": "object",
      "properties": {
        "utc": { "type": "string" },
        "langfuse_trace_id": { "type": "string" },
        "member_finding_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
